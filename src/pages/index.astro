---
import BaseLayout from "../layouts/base-layout.astro";

const description =
  "Bespoke Betty makes custom shirts, hoodies, jumpers and cushions — handmade to order in Australia.";

// Gallery items. Swap `img` paths for Betty's real photos (public/images/work/*).
const work = [
  { title: "Linen shirt", cat: "Shirts", img: "/images/work/01.png" },
  { title: "Loop-back hoodie", cat: "Hoodies", img: "/images/work/02.png" },
  { title: "Lambswool jumper", cat: "Knitwear", img: "/images/work/03.png" },
  { title: "Linen cushion", cat: "Cushions", img: "/images/work/04.png" },
  { title: "Embroidered tee", cat: "Shirts", img: "/images/work/05.png" },
  { title: "Patchwork throw", cat: "Home", img: "/images/work/06.png" },
];

// Lean schema — no storefront/premises, so no address or opening hours.
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Bespoke Betty",
  description,
  url: "https://bespokebetty.com.au",
  image: "https://bespokebetty.com.au/images/og-card.png",
  email: "hello@bespokebetty.com.au",
  priceRange: "$$",
  areaServed: { "@type": "Country", name: "Australia" },
};
---

<BaseLayout title="Bespoke Betty — Handmade to order" description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="hero">
    <div class="container">
      <p class="micro">Made to order — Handmade in Australia</p>
      <h1>Made<br />to fit<br />you.</h1>
      <p class="lead">
        Custom shirts, hoodies, jumpers and cushions — sewn one at a time, in the colours and
        cuts you actually want.
      </p>
      <a class="cta micro" href="#contact">Start a piece →</a>
    </div>
  </section>

  <section id="work" class="block">
    <div class="container">
      <div class="rowhead">
        <h2>Selected work</h2>
        <span class="micro">Six pieces</span>
      </div>
      <div class="grid">
        {
          work.map((item, i) => (
            <figure class="tile">
              <img src={item.img} alt={`${item.title} — ${item.cat}`} loading="lazy" width="600" height="600" />
              <figcaption class="tcap">
                <b>{item.title}</b>
                <span class="tnum">
                  {String(i + 1).padStart(2, "0")} / {item.cat}
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section id="about" class="block">
    <div class="container">
      <div class="rowhead"><h2>The maker</h2></div>
      <div class="about">
        <div class="about__figure">
          <img src="/images/betty.png" alt="Betty in her studio" width="600" height="600" loading="lazy" />
        </div>
        <div class="about__copy">
          <p class="micro">Betty</p>
          <h3>Hello, I'm Betty.</h3>
          <p>
            I've been sewing for as long as I can remember. Bespoke Betty is where I make custom
            pieces to order — a jumper in the exact grey you've been hunting for, a cushion cut
            from your grandmother's fabric, a shirt that finally fits.
          </p>
          <p>
            Every piece is made by hand, one at a time. Tell me what you have in mind and we'll
            work it out together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="block block--last">
    <div class="container">
      <div class="contact">
        <div class="contact__intro">
          <p class="micro">Get in touch</p>
          <h2>Let's make<br />something.</h2>
          <p class="lead">Send a few details and I'll get back to you within a couple of days.</p>
        </div>
        <form
          name="contact"
          method="POST"
          action="/success"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p hidden>
            <label>Don't fill this in: <input name="bot-field" /></label>
          </p>
          <div class="field">
            <label class="micro" for="name">Name</label>
            <input id="name" type="text" name="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label class="micro" for="email">Email</label>
            <input id="email" type="email" name="email" placeholder="you@example.com" required />
          </div>
          <div class="field">
            <label class="micro" for="message">What would you like made?</label>
            <textarea id="message" name="message" rows="4" placeholder="A jumper, a cushion, an idea…" required></textarea>
          </div>
          <button class="button" type="submit">Send enquiry</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(3.5rem, 9vw, 6.5rem) 0 clamp(3rem, 7vw, 5rem);
  }

  .hero h1 {
    font-size: clamp(2.7rem, 9vw, 6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 1.4rem 0 0;
    text-transform: uppercase;
  }

  .lead {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin: 1.6rem 0 0;
    max-width: 42ch;
  }

  .cta {
    border: 1px solid var(--color-text);
    display: inline-block;
    margin-top: 2rem;
    padding: 0.7rem 1.4rem;
  }

  .cta:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }

  .block {
    border-bottom: 1px solid var(--color-line);
    padding: clamp(2.5rem, 6vw, 4rem) 0;
  }

  .block--last {
    border-bottom: 0;
  }

  .rowhead {
    align-items: baseline;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1.8rem;
  }

  .rowhead h2 {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0;
    text-transform: uppercase;
  }

  .grid {
    border-left: 1px solid var(--color-line);
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }

  .tile {
    border-bottom: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
    margin: 0;
  }

  .tile img {
    aspect-ratio: 1 / 1;
    background: #d6d2c9;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .tcap {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0.8rem;
  }

  .tcap b {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .tnum {
    color: var(--color-muted);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
  }

  .about {
    border-left: 1px solid var(--color-line);
    border-top: 1px solid var(--color-line);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
  }

  .about__figure,
  .about__copy {
    border-bottom: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }

  .about__figure img {
    aspect-ratio: 1 / 1;
    background: #d4cfc5;
    display: block;
    height: 100%;
    object-fit: cover;
    width: 100%;
  }

  .about__copy {
    padding: clamp(1.5rem, 4vw, 2.6rem);
  }

  .about__copy h3 {
    font-size: clamp(1.6rem, 3.5vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 1rem 0 0;
  }

  .about__copy p:not(.micro) {
    color: var(--color-muted);
    margin: 1rem 0 0;
  }

  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1fr 1.3fr;
  }

  .contact__intro h2 {
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.9rem 0 0;
    text-transform: uppercase;
  }

  form {
    display: grid;
    gap: 1.1rem;
  }

  .field label {
    display: block;
    margin-bottom: 0.4rem;
  }

  input,
  textarea {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-text);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem 0.85rem;
    width: 100%;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-text);
    outline: 2px solid transparent;
  }

  button.button {
    justify-self: start;
  }

  @media (max-width: 820px) {
    .grid,
    .about {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .grid,
    .about {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      scroll-behavior: auto;
    }
  }
</style>
