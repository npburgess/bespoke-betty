---
import BaseLayout from "../layouts/base-layout.astro";

const description =
  "Bespoke Betty makes custom shirts, hoodies, jumpers and cushions — handmade to order in Australia.";

// Gallery items. Swap `img` paths for Betty's real photos (public/images/work/*).
const work = [
  { title: "Linen shirt", cat: "Shirts", img: "/images/work/01.png" },
  { title: "Loop-back hoodie", cat: "Hoodies", img: "/images/work/02.png" },
  { title: "Lambswool jumper", cat: "Knitwear", img: "/images/work/03.png" },
  { title: "Linen cushion", cat: "Cushions", img: "/images/work/04.png" },
  { title: "Embroidered tee", cat: "Shirts", img: "/images/work/05.png" },
  { title: "Patchwork throw", cat: "Home", img: "/images/work/06.png" },
];

// Lean schema — no storefront/premises, so no address or opening hours.
const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Bespoke Betty",
  description,
  url: "https://bespokebetty.com.au",
  image: "https://bespokebetty.com.au/images/og-card.png",
  email: "hello@bespokebetty.com.au",
  priceRange: "$$",
  areaServed: { "@type": "Country", name: "Australia" },
};
---

<BaseLayout title="Bespoke Betty — Handmade to order" description={description}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <section class="hero">
    <div class="container">
      <p class="eyebrow">Made to order · Handmade in Australia</p>
      <h1>Softly made, <em>just for you.</em></h1>
      <p class="lead">
        Custom shirts, hoodies, jumpers and cushions — sewn one at a time, in the colours and
        cuts you actually want.
      </p>
      <a class="button" href="#contact">Start a piece</a>
    </div>
  </section>

  <div class="container"><hr class="stitch" /></div>

  <section id="work" class="block">
    <div class="container">
      <div class="head">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>A few recent makes</h2>
        </div>
      </div>
      <div class="grid">
        {
          work.map((item, i) => (
            <figure class="tile">
              <img class="tile__img" src={item.img} alt={`${item.title} — ${item.cat}`} loading="lazy" width="600" height="750" />
              <figcaption class="tcap">
                <b>{item.title}</b>
                <span>{item.cat}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <div class="container"><hr class="stitch" /></div>

  <section id="about" class="block">
    <div class="container">
      <div class="about">
        <div class="about__figure">
          <img src="/images/betty.png" alt="Betty in her studio" width="600" height="600" loading="lazy" />
        </div>
        <div class="about__copy">
          <p class="eyebrow">The maker</p>
          <h2>Hello, I'm Betty.</h2>
          <p>
            I've been sewing for as long as I can remember. Bespoke Betty is where I make custom
            pieces to order — a jumper in the exact grey you've been hunting for, a cushion cut
            from your grandmother's fabric, a shirt that finally fits.
          </p>
          <p>
            Every piece is made by hand, one at a time. Tell me what you have in mind and we'll
            work it out together.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="container"><hr class="stitch" /></div>

  <section id="contact" class="block">
    <div class="container">
      <div class="contact">
        <p class="eyebrow">Get in touch</p>
        <h2>Let's make something.</h2>
        <p class="lead lead--center">
          Send a few details and I'll get back to you within a couple of days.
        </p>
        <form
          name="contact"
          method="POST"
          action="/success"
          data-netlify="true"
          netlify-honeypot="bot-field"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p hidden>
            <label>Don't fill this in: <input name="bot-field" /></label>
          </p>
          <div class="field">
            <label class="eyebrow" for="name">Name</label>
            <input id="name" type="text" name="name" placeholder="Your name" required />
          </div>
          <div class="field">
            <label class="eyebrow" for="email">Email</label>
            <input id="email" type="email" name="email" placeholder="you@example.com" required />
          </div>
          <div class="field">
            <label class="eyebrow" for="message">What would you like made?</label>
            <textarea id="message" name="message" rows="4" placeholder="A jumper, a cushion, an idea…" required></textarea>
          </div>
          <button class="button" type="submit">Send enquiry</button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: clamp(3.5rem, 9vw, 6.5rem) 0 clamp(2.5rem, 6vw, 4rem);
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(3rem, 8.5vw, 5.6rem);
    margin: 1.3rem auto 0;
    max-width: 15ch;
  }

  .hero h1 em {
    color: var(--color-accent);
    font-style: italic;
  }

  .lead {
    color: var(--color-muted);
    font-size: 1.14rem;
    margin: 1.5rem auto 0;
    max-width: 44ch;
  }

  .hero .button {
    margin-top: 2rem;
  }

  .block {
    padding: clamp(3rem, 7vw, 5rem) 0;
  }

  .head {
    margin-bottom: 2rem;
  }

  .head h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0.4rem 0 0;
  }

  .grid {
    display: grid;
    gap: 1.4rem;
    grid-template-columns: repeat(3, 1fr);
  }

  .tile {
    background: var(--color-surface);
    border: 2px dashed var(--color-line);
    border-radius: var(--radius);
    margin: 0;
    padding: 0.55rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .tile:hover {
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .tile__img {
    aspect-ratio: 4 / 5;
    background: #d3c6b4;
    border-radius: 8px;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .tcap {
    align-items: baseline;
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0.4rem 0.3rem;
  }

  .tcap b {
    font-weight: 500;
  }

  .tcap span {
    color: var(--color-muted);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .about {
    align-items: center;
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: 1.1fr 1fr;
  }

  .about__figure {
    border: 2px dashed var(--color-line);
    border-radius: var(--radius);
    padding: 0.55rem;
  }

  .about__figure img {
    aspect-ratio: 1 / 1;
    background: #cfc4b2;
    border-radius: 8px;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .about__copy h2 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    margin: 0.8rem 0 0;
  }

  .about__copy p:not(.eyebrow) {
    color: var(--color-muted);
    margin: 1rem 0 0;
  }

  .contact {
    background: var(--color-surface);
    border: 2px dashed var(--color-line);
    border-radius: var(--radius);
    padding: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .contact h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.7rem 0 0;
  }

  .lead--center {
    margin-bottom: 1.8rem;
    max-width: 40ch;
  }

  form {
    display: grid;
    gap: 1.1rem;
    margin: 0 auto;
    max-width: 32rem;
    text-align: left;
  }

  .field label {
    display: block;
    margin-bottom: 0.45rem;
  }

  input,
  textarea {
    background: var(--color-bg);
    border: 1px solid var(--color-line);
    border-radius: 10px;
    color: var(--color-text);
    font-family: inherit;
    font-size: 1rem;
    padding: 0.75rem 0.9rem;
    width: 100%;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(176, 137, 104, 0.2);
    outline: 2px solid transparent;
  }

  form .button {
    justify-self: center;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
