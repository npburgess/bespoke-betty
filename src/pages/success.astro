---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="Bespoke Betty — Thank you" description="Your enquiry has been sent.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="thanks">
    <div class="container">
      <p class="eyebrow">Enquiry sent</p>
      <h1>Thank you.</h1>
      <p class="lead">
        Your message is on its way to Betty. You'll hear back within a couple of days.
      </p>
      <a class="button" href="/">Back to work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    padding: clamp(4rem, 12vw, 8rem) 0;
    text-align: center;
  }

  .thanks h1 {
    font-size: clamp(3rem, 9vw, 5rem);
    margin: 1.2rem 0 0;
  }

  .lead {
    color: var(--color-muted);
    font-size: 1.14rem;
    margin: 1.4rem auto 0;
    max-width: 42ch;
  }

  .thanks .button {
    margin-top: 2rem;
  }
</style>
