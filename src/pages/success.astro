---
import BaseLayout from "../layouts/base-layout.astro";
---

<BaseLayout title="Bespoke Betty — Thank you" description="Your enquiry has been sent.">
  <meta name="robots" content="noindex" slot="head" />
  <section class="thanks">
    <div class="container">
      <p class="micro">Enquiry sent</p>
      <h1>Thank you.</h1>
      <p class="lead">
        Your message is on its way to Betty. You'll hear back within a couple of days.
      </p>
      <a class="cta micro" href="/">← Back to work</a>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    padding: clamp(4rem, 12vw, 8rem) 0;
  }

  .thanks h1 {
    font-size: clamp(2.7rem, 9vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    margin: 1.2rem 0 0;
    text-transform: uppercase;
  }

  .lead {
    color: var(--color-muted);
    font-size: 1.1rem;
    margin: 1.4rem 0 0;
    max-width: 42ch;
  }

  .cta {
    border: 1px solid var(--color-text);
    display: inline-block;
    margin-top: 2rem;
    padding: 0.7rem 1.4rem;
  }

  .cta:hover {
    background: var(--color-text);
    color: var(--color-bg);
  }
</style>
