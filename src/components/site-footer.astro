---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <span>Bespoke Betty — Made to order in Australia</span>
    <span>&copy; {year} · <a href="mailto:miriam@bespokebetty.com.au">miriam@bespokebetty.com.au</a></span>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--color-muted);
    font-size: 0.85rem;
    padding: 2rem 0 3rem;
  }

  .site-footer__inner {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
  }

  .site-footer a:hover {
    color: var(--color-text);
  }
</style>
